{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    // Runs under Node only: benchmarks measure the reference platform, and the
    // browser legs of Spike B are the viewer's own diagnostics overlay.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../packages/core" }, { "path": "../packages/golden" }]
}
