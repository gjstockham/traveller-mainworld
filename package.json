{
  "name": "traveller-mainworld",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && pnpm lint:kernel && pnpm lint:wasm",
    "lint:kernel": "node scripts/check-kernel-whitelist.mjs",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "golden:verify": "pnpm --filter @traveller-mainworld/golden build && pnpm --filter @traveller-mainworld/golden golden:verify",
    "golden:update": "pnpm --filter @traveller-mainworld/golden build && pnpm --filter @traveller-mainworld/golden golden:update",
    "lint:wasm": "node scripts/check-wasm-flags.mjs && node scripts/gen-wasm-rotations.mjs --check",
    "wasm:build": "node scripts/build-wasm.mjs",
    "wasm:test": "cargo test --release --manifest-path crates/kernel-wasm/Cargo.toml",
    "golden:parity": "pnpm --filter @traveller-mainworld/golden build && pnpm --filter @traveller-mainworld/golden golden:parity",
    "check:parity": "pnpm wasm:build && pnpm wasm:test && pnpm golden:parity",
    "bench": "pnpm --filter @traveller-mainworld/bench build && node --expose-gc bench/dist/cli.js",
    "bench:quick": "pnpm --filter @traveller-mainworld/bench build && node --expose-gc bench/dist/cli.js --quick"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
