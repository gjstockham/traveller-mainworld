{
  "name": "@traveller-mainworld/golden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Golden-hash fixtures, manifest and runners (PRD R16).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/wasmLoader.d.ts",
      "default": "./dist/wasmLoader.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "manifest.json",
    "fixtures.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly && tsc -p tsconfig.web.json",
    "golden:verify": "node dist/cli.js verify",
    "golden:verify:battery": "node dist/cli.js verify --only=battery",
    "golden:verify:fixtures": "node dist/cli.js verify --only=fixtures",
    "golden:update": "node dist/cli.js update",
    "golden:update:fixtures": "node dist/cli.js update:fixtures",
    "golden:parity": "node dist/parity-cli.js",
    "build:web": "node build-web.mjs",
    "preview:web": "vite preview --port 4174 --strictPort --host 127.0.0.1",
    "serve:web": "vite build && vite preview --port 4174 --strictPort --host",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@traveller-mainworld/core": "workspace:*"
  },
  "devDependencies": {
    "vite": "^7.1.12"
  }
}
