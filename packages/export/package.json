{
  "name": "@traveller-mainworld/export",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Projected 2D map export, rendered from generation data (PRD R23-R26).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "render": "node dist/cli.js"
  },
  "dependencies": {
    "@traveller-mainworld/core": "workspace:*"
  }
}
